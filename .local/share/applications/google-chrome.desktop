# Override of /usr/share/applications/google-chrome.desktop.
# Sole purpose: add --password-store=kwallet to every Exec line.
#
# Why: Chrome auto-detects its cookie/password encryption backend. On KDE it
# picks the Secret Service *portal*, whose kwallet provider intermittently fails
# to register at login (journal: "Could not register app ID ... org.kde.kwalletd").
# On failure Chrome falls back to the plaintext `basic` key and re-encrypts
# cookies with it; the next launch uses the kwallet key again and can no longer
# decrypt them -> logged out of every site after a reboot/resume. Pinning kwallet
# bypasses the flaky portal and always uses the stable key in kdewallet
# (unlocked at login by pam_kwallet5 -> kwalletd6).

[Desktop Entry]
Version=1.0
Name=Google Chrome
GenericName=Web Browser
Exec=/usr/bin/google-chrome-stable --password-store=kwallet %U
Icon=google-chrome
Type=Application
Terminal=false
StartupNotify=true
StartupWMClass=Google-chrome
Categories=Network;WebBrowser;
MimeType=application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/google-chrome;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/google-chrome-stable --password-store=kwallet

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=/usr/bin/google-chrome-stable --password-store=kwallet --incognito
