# regedit and Windows PowerShell expect CRLF; keep them whatever core.autocrlf says on the committing machine.
*.reg text eol=crlf
*.ps1 text eol=crlf
# Git Bash runs these through their shebang, on Windows too: a CRLF checkout
# makes it `bun\r`, a command that does not exist.
*.sh text eol=lf
*.ts text eol=lf
