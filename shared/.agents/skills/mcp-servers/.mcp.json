{
  "mcpServers": {
    "rohlik": {
      "type": "http",
      "url": "https://mcp.rohlik.cz/mcp"
    },
    "vaadin": {
      "type": "http",
      "url": "https://mcp.vaadin.com/docs"
    },
    "betterstack": {
      "type": "http",
      "url": "https://mcp.betterstack.com"
    },
    "azure-devops": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "f=\"$HOME/.config/bash_aliases.d/99-local.sh\"; [ -r \"$f\" ] && . \"$f\"; [ -n \"$AZDO_ORG\" ] || { echo 'azure-devops: AZDO_ORG is unset, run make claude' >&2; exit 0; }; exec npx -y @azure-devops/mcp \"$AZDO_ORG\" -d core repositories pipelines search"
      ]
    },
    "forgejo": {
      "type": "http",
      "url": "https://forgejo-mcp.dog-macaroni.ts.net/mcp"
    },
    "adminer-desktop": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "b=$(command -v adminer-desktop || echo \"/Applications/Adminer Desktop.app/Contents/MacOS/adminer-desktop\"); [ -x \"$b\" ] || exit 0; exec \"$b\" -mcp"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y chrome-devtools-mcp@1.11.0 --browser-url http://127.0.0.1:9222 --no-usage-statistics --no-performance-crux"
      ]
    }
  }
}
