{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/rules/*.md"
  ],
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    },
    "rohlik": {
      "url": "https://mcp.rohlik.cz/mcp",
      "enabled": true,
      "type": "remote"
    },
    "vaadin": {
      "url": "https://mcp.vaadin.com/docs",
      "enabled": true,
      "type": "remote"
    },
    "azure-devops": {
      "command": [
        "sh",
        "-c",
        "[ -n \"$AZDO_ORG\" ] || exit 0; exec npx -y @azure-devops/mcp \"$AZDO_ORG\" -d core repositories pipelines search"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "tree": "allow",
      "tree *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "patch *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "cd *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "make": "allow",
      "make *": "allow",
      "./gradlew *": "allow",
      "npm *": "allow",
      "yarn *": "allow",
      "nvm *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "pipenv *": "allow",
      "cargo build*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "cargo run*": "allow",
      "cargo install*": "allow",
      "cargo update*": "allow",
      "cargo clean*": "allow",
      "rustc *": "allow",
      "rustup *": "allow",
      "sqlite3 *": "allow",
      "diesel *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "ping *": "allow",
      "nslookup *": "allow",
      "dig *": "allow",
      "scp *": "allow",
      "docker *": "allow",
      "docker-compose *": "allow",
      "terraform *": "allow",
      "ps": "allow",
      "ps *": "allow",
      "top": "allow",
      "htop": "allow",
      "pkill *": "allow",
      "systemctl *": "allow",
      "journalctl *": "allow",
      "tar *": "allow",
      "gzip *": "allow",
      "gunzip *": "allow",
      "zip *": "allow",
      "unzip *": "allow",
      "az account *": "allow",
      "az devops *": "allow",
      "az repos *": "allow",
      "az pipelines *": "allow",
      "az monitor *": "allow",
      "az resource list *": "allow",
      "git push*main*": "deny",
      "git push*master*": "deny",
      "gh pr merge*": "deny",
      "gh pr close*": "deny",
      "gh repo delete*": "deny",
      "gh release delete*": "deny",
      "gh secret*": "deny",
      "gh auth*": "deny",
      "gh api*-X DELETE*": "deny",
      "gh api*--method DELETE*": "deny",
      "rm -rf /*": "deny",
      "sudo rm -rf*": "deny",
      "chmod 777*": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "init *": "deny",
      "killall*": "deny",
      "sudo su*": "deny",
      "passwd*": "deny",
      "usermod*": "deny",
      "userdel*": "deny",
      "groupdel*": "deny"
    }
  }
}
