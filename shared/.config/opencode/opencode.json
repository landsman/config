{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/rules/*.md"
  ],
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    },
    "rohlik": {
      "url": "https://mcp.rohlik.cz/mcp",
      "enabled": true,
      "type": "remote"
    },
    "vaadin": {
      "url": "https://mcp.vaadin.com/docs",
      "enabled": true,
      "type": "remote"
    },
    "azure-devops": {
      "command": [
        "sh",
        "-c",
        "[ -n \"$AZDO_ORG\" ] || exit 0; exec npx -y @azure-devops/mcp \"$AZDO_ORG\" -d core repositories pipelines search"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git push*main*": "deny",
      "git push*master*": "deny",
      "gh pr merge*": "deny",
      "gh pr close*": "deny",
      "gh repo delete*": "deny",
      "gh release delete*": "deny",
      "rm -rf /": "deny",
      "sudo rm -rf*": "deny"
    }
  }
}