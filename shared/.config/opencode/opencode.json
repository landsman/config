{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/rules/*.md",
    "{env:BRAIN_DIR}/wiki/index.md"
  ],
  "mcp": {
    "servers": {
      "pencil": {
        "type": "local",
        "command": [
          "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
          "--app",
          "desktop",
          "--agent",
          "openCodeCLI"
        ]
      },
      "rohlik": {
        "type": "remote",
        "url": "https://mcp.rohlik.cz/mcp"
      },
      "vaadin": {
        "type": "remote",
        "url": "https://mcp.vaadin.com/docs"
      },
      "betterstack": {
        "type": "remote",
        "url": "https://mcp.betterstack.com"
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "azure-devops": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "[ -n \"$AZDO_ORG\" ] || exit 0; exec npx -y @azure-devops/mcp \"$AZDO_ORG\" -d core repositories pipelines search"
        ]
      },
      "adminer-desktop": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "b=$(command -v adminer-desktop || echo \"/Applications/Adminer Desktop.app/Contents/MacOS/adminer-desktop\"); [ -x \"$b\" ] || exit 0; exec \"$b\" -mcp"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec npx -y chrome-devtools-mcp@1.11.0 --browser-url http://127.0.0.1:9222 --no-usage-statistics --no-performance-crux"
        ]
      },
      "forgejo": {
        "type": "remote",
        "url": "{env:FORGEJO_MCP_URL}",
        "oauth": {
          "client_id": "{env:FORGEJO_MCP_CLIENT_ID}",
          "callback_port": 53682,
          "redirect_uri": "http://localhost:53682/callback"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd": "allow",
      "tree *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "column *": "allow",
      "od *": "allow",
      "hexdump *": "allow",
      "xxd *": "allow",
      "strings *": "allow",
      "base64 *": "allow",
      "md5 *": "allow",
      "shasum *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "whoami": "allow",
      "date *": "allow",
      "uname *": "allow",
      "hostname *": "allow",
      "id *": "allow",
      "diff *": "allow",
      "patch *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "cd *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "make *": "allow",
      "./gradlew *": "allow",
      "npm *": "allow",
      "yarn *": "allow",
      "nvm *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "pipenv *": "allow",
      "cargo build*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "cargo run*": "allow",
      "cargo install*": "allow",
      "cargo update*": "allow",
      "cargo clean*": "allow",
      "rustc *": "allow",
      "rustup *": "allow",
      "sqlite3 *": "allow",
      "diesel *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "ping *": "allow",
      "nslookup *": "allow",
      "dig *": "allow",
      "scp *": "allow",
      "docker *": "allow",
      "docker-compose *": "allow",
      "terraform *": "allow",
      "ps *": "allow",
      "top": "allow",
      "htop": "allow",
      "pkill *": "allow",
      "systemctl *": "allow",
      "journalctl *": "allow",
      "tar *": "allow",
      "gzip *": "allow",
      "gunzip *": "allow",
      "zip *": "allow",
      "unzip *": "allow",
      "az account *": "allow",
      "az devops *": "allow",
      "az repos *": "allow",
      "az pipelines *": "allow",
      "az monitor *": "allow",
      "az resource list *": "allow",
      "git push* main": "deny",
      "git push*:main": "deny",
      "git push* +main": "deny",
      "git push* master": "deny",
      "git push*:master": "deny",
      "git push* +master": "deny",
      "gh pr merge*": "deny",
      "gh pr close*": "deny",
      "gh repo delete*": "deny",
      "gh release delete*": "deny",
      "gh secret*": "deny",
      "gh auth*": "deny",
      "gh api*-X DELETE*": "deny",
      "gh api*--method DELETE*": "deny",
      "rm -rf /*": "deny",
      "sudo rm -rf*": "deny",
      "chmod 777*": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "init *": "deny",
      "killall*": "deny",
      "sudo su*": "deny",
      "passwd*": "deny",
      "usermod*": "deny",
      "userdel*": "deny",
      "groupdel*": "deny"
    }
  }
}
