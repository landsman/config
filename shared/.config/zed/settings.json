// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {
    "make": true,
    "dockerfile": true,
    "sql": true,
    "java": true,
    "kotlin": true,
    "php": true,
    "terraform": true,
    "toml": true,
    "html": true
  },
  // The java extension claims *.gradle.kts as "Gradle KTS", whose highlights
  // query fails to load (Invalid node type "null"), so the file renders plain.
  "file_types": {
    "Kotlin": ["*.gradle.kts"]
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "default",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Sublime Text 4 Colorful",
    "dark": "Sublime Text 4 Colorful",
  },
}
