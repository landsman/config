# ide - all of it except the plugin list, which is how a new machine gets them
# `.idea/*`, not `.idea`: git does not descend into an ignored directory, so the
# negation below would never be reached.
.idea/*
!.idea/externalDependencies.xml

# agent scratch space - worktrees, local settings, session state. Leading slash:
# only the one at the root, `shared/.claude/` is the payload and stays tracked.
/.claude/

# deps
node_modules

# secrets
.env
.env.local
