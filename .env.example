# Copy to .env (gitignored) and fill in. Read by bin/macos/defaults.sh.
#
# Plain configuration only, values that differ per person or machine but are
# not secret. No passwords, tokens or keys: they belong in 1Password, not in
# a plain-text file every script in the repo sources.

# Mail > Settings > Composing > "Send new messages from". Leave empty to let Mail pick.
MAIL_FROM="Full Name <you@example.com>"
