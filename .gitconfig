# No `email` here on purpose. This file is *included* from
# ~/.config/git/config, and git reads config in file order, so whatever this
# file sets wins over everything written above the include line. A machine
# whose [user] section predates the include — mine did — then committed as the
# placeholder address no matter what `make git` wrote, and `make git` refused
# its own freshly-set email as "a placeholder". The address is machine-local:
# `make git` writes it to the global config, which is the only copy.
[user]
	name = Michal Landsman

[init]
	defaultBranch = main

[commit]
	gpgsign = true

[gpg]
	format = ssh

[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global

# A client's name outside the client's own repos stops the commit — see
# bin/git/forbidden-names.sh. The list is in the private brain, not here.
[hook "forbidden-names"]
	command = "$HOME/projects/landsman/config/bin/git/forbidden-names.sh"
	event = pre-commit
	event = commit-msg

# A subject that breaks the commit-messages rule stops the commit — see
# bin/git/commit-convention.ts.
[hook "commit-convention"]
	command = "$HOME/projects/landsman/config/bin/git/commit-convention.sh"
	event = commit-msg

# A new worktree clears out the finished ones, whichever agent left them — see
# bin/git/worktree-sweep.sh.
[hook "worktree-sweep"]
	command = "$HOME/projects/landsman/config/bin/git/worktree-sweep.sh --hook"
	event = post-checkout

# A push in a repo whose Makefile has a `pre-push` target runs it first — see
# bin/git/pre-push.sh.
[hook "push-checks"]
	command = "$HOME/projects/landsman/config/bin/git/pre-push.sh"
	event = pre-push

[forbiddenNames]
	file = ~/projects/landsman/brain/private-names.txt

[branch]
	autosetuprebase = always

[diff]
	algorithm = histogram
	renames = copies

[push]
	default = current

[pull]
	rebase = true

[fetch]
	prune = true

[merge]
	ff = false

[rebase]
	missingCommitsCheck = warn

[status]
	showStash = true

[log]
	date = iso

[alias]
	co = checkout
	cp = cherry-pick
	st = status
	ap = add -p
	ci = commit
	dc = diff --cached
	fpush = push --force-with-lease
	wip = !git add --all && git commit -m 'WIP [ci skip]'
	unwip = reset HEAD~1
	cleanup = !git fetch --all --prune && git branch --merged master | grep -v '\\*\\|master\\|develop' | xargs -n 1 -r git branch -d

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
