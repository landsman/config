# Only the dotfile trees in this package belong in $HOME. Everything else here —
# docs, and the root-owned tree under system/ — must be listed, or stow will
# happily symlink it into the home directory.
#
# Stow ignores `^/README.*` by default, but a local ignore file replaces the
# whole default list rather than extending it, so the usual entries are repeated.
^/README.*
^/docs$
^/system$
^/\.stow-local-ignore$
\.git
\.gitignore
.+~
\#.*\#
