{
  // For the Bun scripts under bin/: Bun reads this at run time, editors for
  // completion, so `@lib/term` works in both without a build step.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@lib/*": ["lib/bun/*"] },
    "module": "Preserve",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": true,
    "noEmit": true
  }
}
